# SENTRIX Frontend Environment Configuration Template
# Direct API mode: http://127.0.0.1:8000
# Production: https://<your-backend-app>.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Proxy Mode Configuration (Recommended for Docker/Production)
# When NEXT_PUBLIC_USE_PROXY=true, client calls /api/proxy, and the Next.js server proxies to BACKEND_URL
NEXT_PUBLIC_USE_PROXY=false
BACKEND_URL=http://127.0.0.1:8000

# Server-Side API Secret (Never exposed to browser bundles)
API_AUTH_TOKEN=

# Optional client default token for local dev only (Leave blank in production SOC deployments)
# Operators enter their session token via the Dashboard Settings page.
NEXT_PUBLIC_API_TOKEN=
