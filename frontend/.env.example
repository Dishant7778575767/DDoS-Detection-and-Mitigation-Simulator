# SENTRIX Frontend Environment Configuration Template
# Local Development: http://127.0.0.1:8000
# Production: https://<your-backend-app>.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# API Bearer Authentication Token (MUST match backend API_AUTH_TOKEN)
NEXT_PUBLIC_API_TOKEN=your-secure-random-token-here-32chars

