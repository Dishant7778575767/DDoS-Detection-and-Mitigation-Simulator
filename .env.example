# ==============================================================================
# SENTRIX Production & Local Runtime Configuration Template
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
APP_ENV=development

# Primary Approved Random Forest Classifier Artifact
MODEL_PATH=models/approved_model.joblib

# Database URL:
# For local development / quickstart:
DATABASE_URL=sqlite:///./sentrix.db
# For production PostgreSQL (e.g. Supabase pooler):
# DATABASE_URL=postgresql://postgres.<user>:<password>@<host>:5432/postgres

# API Authentication & Security
API_AUTH_REQUIRED=true
API_AUTH_TOKEN=generate-a-strong-random-token-here

# AWS CloudFront Real-Time Logs & Amazon Kinesis Data Streams
AWS_REGION=ap-south-1
AWS_KINESIS_STREAM_NAME=sentrix-cloudfront-realtime-logs
AWS_KINESIS_CONSUMER_ENABLED=false
AWS_KINESIS_BATCH_SIZE=1000
AWS_KINESIS_POLL_INTERVAL_SECONDS=1.0
AWS_KINESIS_ITERATOR_TYPE=LATEST

# Optional Static AWS Credentials (leave empty when running on EC2 / ECS / EKS with IAM Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Keepalive Secret for Free-Tier Supabase Anti-Pausing Endpoint (/internal/keepalive)
KEEPALIVE_SECRET=your-keepalive-secret-key-here

# Allowed CORS Origins (comma-separated; regex allows *.vercel.app automatically)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
